{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmitOnError": true,
    "verbatimModuleSyntax": true,
    "rootDir": "kasimargin/web/src",
    "outDir": "kasimargin/web/build"
  },
  "include": ["kasimargin/web/src/**/*.ts"]
}
